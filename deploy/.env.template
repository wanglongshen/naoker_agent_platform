# 由 deploy.sh 自动生成，勿手改
FE_PORT=__FE_PORT__
BE_PORT=__BE_PORT__
PG_PORT=__PG_PORT__
POSTGRES_DB=rbac
POSTGRES_USER=agent
POSTGRES_PASSWORD=__GENERATE__
DATABASE_URL=postgresql+asyncpg://agent:__GENERATE__@postgres:5432/rbac
JWT_SECRET=__FROM_PROD_ENV__
JWT_EXPIRE_MINUTES=43200
COOKIE_SECURE=false
CORS_ORIGINS=http://__SERVER_IP__:__FE_PORT__
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=__FROM_PROD_ENV__
DEEPSEEK_API_KEY=__FROM_PROD_ENV__
DEEPSEEK_MODEL=deepseek-v4-flash
TAVILY_API_KEY=__FROM_PROD_ENV__
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=1
WEB_RENDERER_URL=http://web-renderer:9001
WEB_RENDERER_HEADLESS=true
WEB_RENDERER_CHANNEL=
# ---- DSH（vendored deepseek-harness，随 backend 镜像构建）----
# 实例模式：vendored=用镜像内 /app/deepseek-harness 构建产物（线上唯一正确值）
DSH_INSTANCE_MODE=vendored
# 每用户 DSH_HOME 根目录（容器内路径，agent-dsh 卷挂载点）
DSH_HOME_ROOT=/app/backend/var/dsh
# DSH web /api 浏览器信任围栏：平台公网权威（浏览器经平台代理访问 DSH 时透传 Host）
DSH_TRUSTED_HOSTS=__SERVER_IP__:__BE_PORT__
# connector 插件回调平台 API 的基地址（容器网络内走 service 名）
DSH_PLATFORM_BASE=http://backend:8000
# 任务链单个 DSH headless 子任务超时（秒）
DSH_TASK_TIMEOUT_SECONDS=300
# ---- 任务链计费 ----
# DSH usage 采集失败/为 0 时的任务级粗粒度扣分（降级口径）
TASK_CHAIN_FLAT_POINTS=20
# ---- RAG embedding 供给 ----
# local=sentence-transformers 本地模型（需容器内可下载模型）；http=OpenAI 兼容 /embeddings
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DIM=512
# provider=http 时填写；留空则忽略
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
FEISHU_APP_ID=__FROM_PROD_ENV__
FEISHU_APP_SECRET=__FROM_PROD_ENV__
FEISHU_REDIRECT_URI=http://__SERVER_IP__:__BE_PORT__/api/feishu/oauth/callback
FEISHU_TOKEN_ENCRYPTION_KEY=__FROM_PROD_ENV__
NEXT_PUBLIC_API_BASE_URL=http://__SERVER_IP__:__BE_PORT__
