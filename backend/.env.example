DATABASE_URL=postgresql+asyncpg://rbac:rbac_local_password@localhost:5432/rbac
TEST_DATABASE_URL=postgresql+asyncpg://rbac:rbac_local_password@localhost:5432/rbac_test
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRE_MINUTES=30
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe-Strong1

WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_LEASE_SECONDS=60
WORKER_SHUTDOWN_GRACE_SECONDS=30
HTTP_TIMEOUT_SECONDS=25.0
STEP_TIMEOUT_SECONDS=30.0
RUN_TIMEOUT_SECONDS=120.0
RETRY_BACKOFF_BASE_SECONDS=2.0
RETRY_BACKOFF_MAX_SECONDS=30.0
MAX_RETRY_ATTEMPTS=3
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
TAVILY_API_KEY=tvly-your-tavily-api-key
TAVILY_BASE_URL=https://api.tavily.com
# 仅本地开发/差分录制：允许 web 工具访问非公网解析地址（如 Clash fake-IP 198.18.0.0/15）。
# 生产必须保持 false（SSRF 防线）。
WEB_TOOL_ALLOW_NON_GLOBAL_TARGETS=false
AGENT_STORAGE_ROOT=./var/agent
AGENT_ATTACHMENT_MAX_BYTES=2000000
AGENT_ATTACHMENT_MAX_COUNT=5
AGENT_ATTACHMENT_RETENTION_DAYS=90
AGENT_RUN_RETENTION_DAYS=180
AGENT_ANSWER_DELTA_FLUSH_CHARACTERS=8
AGENT_ANSWER_DELTA_FLUSH_SECONDS=0.016
# LangGraph 单轨（默认 true）。回退旧 while 轨：设为 false。
LANGGRAPH_ENABLED=true

# DSH 运行时：vendored 模式=线上；dev_bin 模式=直接用全局 dsh 调试
DSH_HOME_ROOT=var/dsh
DSH_INSTANCE_MODE=dev_bin
DSH_TRUSTED_HOSTS=localhost:3000
DSH_PLATFORM_TOKEN_TTL_SECONDS=300
